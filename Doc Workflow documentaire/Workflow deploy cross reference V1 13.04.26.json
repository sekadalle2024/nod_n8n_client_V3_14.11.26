        "jsCode": "let targetFolderId;\n\nif ($input.item.json.files) {\n  // Vient de la branche 'Existe déjà'\n  targetFolderId = $input.item.json.files[0].id;\n} else {\n  // Vient de la branche 'Création'\n  targetFolderId = $input.item.json.id;\n}\n\nconst crossRef = $('Cross references Form').item.json['Cross référence'];\nconst docName = $('Cross references Form').item.json.Document;\nconst fileName = `[${crossRef}]-${docName}`;\n\nreturn {\n  json: {\n    targetFolderId: targetFolderId,\n    fileName: fileName\n  }\n};"
