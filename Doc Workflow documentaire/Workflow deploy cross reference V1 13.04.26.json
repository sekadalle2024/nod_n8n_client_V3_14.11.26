      "parameters": {
        "jsCode": "const cycles = [\n  \"Capitaux propres\", \"Charge d'exploitation\", \"Client\", \n  \"Fournisseur\", \"Immobilisations\", \"Impôt et taxes\", \n  \"Personnel\", \"Stock\", \"Trésorerie\", \"Ventes\"\n];\n\nconst parentId = $input.item.json.id;\n\nreturn cycles.map(cycle => ({\n  json: {\n    cycleName: cycle,\n    parentId: parentId,\n    isTarget: cycle === $('Cross references Form').item.json['Cycle comptable']\n  }\n}));"
